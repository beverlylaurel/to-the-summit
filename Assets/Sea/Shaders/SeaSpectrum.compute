// ROLE: builds the initial Fourier amplitudes and the time-dependent
// spectrum from the TMA spectrum. The IFFT input is prepared here.
// CALLED BY: SeaSimulation.

#pragma kernel KInitialSpectrum
#pragma kernel KTimeSpectrum

#include "SeaCommon.hlsl"

// h0(k) and h0*(-k). xy = h0(k), zw = conj(h0(-k)).
RWTexture2DArray<float4> _SeaH0RW;

// IFFT inputs. PACKING: two REAL fields go into one complex channel.
//
//   C = A + i*B  =>  IFFT(C).x = A(x),  IFFT(C).y = B(x)
//
// As long as A and B are real this is exact, and it halves the number of
// FFTs. Spec 11.1 provides two ARGBHalf textures; eight real fields only fit
// into those two through this packing.
//
//   _SeaSpectrumHtRW.xy    = pack(Dx,       Dz)
//   _SeaSpectrumHtRW.zw    = pack(h,        dDx/dz)
//   _SeaSpectrumSlopeRW.xy = pack(slope x,  slope z)
//   _SeaSpectrumSlopeRW.zw = pack(dDx/dx,   dDz/dz)
RWTexture2DArray<float4> _SeaSpectrumHtRW;
RWTexture2DArray<float4> _SeaSpectrumSlopeRW;

/// Upper bound of a tier's band (rad/m). Tier i carries waves with
/// k < _SeaTierCutoffK[i] and k >= _SeaTierCutoffK[i-1].
float4 _SeaTierCutoffK;

// --- Swell partition (the spectrum's second peak) ---
float _SeaSwellAlpha;       // energy scale; the storm producing it is not simulated
float _SeaSwellPeakOmega;   // 2*pi / peak period (rad/s)
float _SeaSwellGamma;       // peak sharpness; higher than the wind sea's
float _SeaSwellSpreadS;     // cosine-2s exponent, fixed across frequency
float _SeaSwellDirOffset;   // radians from the wind direction

// ------------------------------------------------------------------ random

/// Integer hash. [SOURCE: Wang hash / PCG mixing steps]
uint SeaHash(uint x)
{
    x ^= 2747636419u;
    x *= 2654435769u;
    x ^= x >> 16;
    x *= 2654435769u;
    x ^= x >> 16;
    x *= 2654435769u;
    return x;
}

float SeaRand01(uint seed)
{
    return SeaHash(seed) * (1.0 / 4294967296.0);
}

/// TWO INDEPENDENT GAUSSIANS, mean 0 standard deviation 1.
///
/// A PLAIN UNIFORM IS NOT USED. Spec 6.1: if the generator is not Gaussian
/// the whole system SILENTLY produces a wrong result — the surface shows a
/// regular pattern and the bug gets hunted somewhere else for weeks.
/// [SOURCE: Box-Muller transform]
float2 SeaGauss(uint seed)
{
    float u1 = max(SeaRand01(seed), 1e-7);
    float u2 = SeaRand01(seed + 1u);

    float r     = sqrt(-2.0 * log(u1));
    float theta = SEA_TWO_PI * u2;

    return float2(r * cos(theta), r * sin(theta));
}

// ---------------------------------------------------------------- spectrum

/// JONSWAP peak frequency (rad/s).
///
/// omega_p = 22 * (g^2 / (U10 * F))^(1/3)
///
/// THE EXPONENT IS MISSING IN THE SPEC (§6.2 writes "22 * (g^2/(U10*F))").
/// A dimensional check says the exponent is 1/3: g^2/(U*F) has units 1/s^3,
/// and its cube root is 1/s = rad/s. Without the exponent it does not yield
/// rad/s.
/// Check (U=8 m/s, F=12 km): 22*(96.24/96000)^(1/3) = 2.20 rad/s,
/// Tp = 2.86 s. The independent JONSWAP relation
/// f_p = 3.5 (g/U)(gF/U^2)^-0.33 gives 2.26 rad/s for the same inputs — they
/// agree.
/// [SOURCE: Horvath 2015 / JONSWAP]
float SeaPeakOmega(float u10, float fetch)
{
    return 22.0 * pow(max(SEA_G * SEA_G / (u10 * fetch), 1e-12), 1.0 / 3.0);
}

/// JONSWAP spectrum. [SOURCE: Horvath 2015 / JONSWAP]
float SeaJonswap(float omega, float omegaP, float u10, float fetch)
{
    float alpha = 0.076 * pow(max(u10 * u10 / (fetch * SEA_G), 1e-12), 0.22);

    float sigma = omega <= omegaP ? SEA_JONSWAP_SIGMA_LO : SEA_JONSWAP_SIGMA_HI;
    float delta = omega - omegaP;
    float r     = exp(-(delta * delta) / (2.0 * sigma * sigma * omegaP * omegaP));

    float w4 = omegaP / omega;
    w4 = w4 * w4 * w4 * w4;

    return alpha * (SEA_G * SEA_G / pow(omega, 5.0))
         * exp(-1.25 * w4)
         * pow(SEA_JONSWAP_GAMMA, r);
}

/// KITAIGORODSKII DEPTH ATTENUATION, THREE BRANCHES.
///
/// The depth parameter is MANDATORY for a sea viewed from the shore
/// (spec 6.2); that is why the Phillips spectrum is not used.
///
/// THE SPEC'S SINGLE-LINE FORM IS A TRAP. It carries the parabola
/// `1 - 0.5(2-wh)^2` past wh > 2 as well; the parabola peaks at wh = 2 and
/// then FALLS BACK, and `saturate` clamps it to 0. The result: the energy of
/// every short wave is erased. Measured — at 60 m depth the h0 texture of
/// tiers 1 and 2 came out entirely zero, while the peak wavelength is 12.7 m
/// and sits in exactly those tiers.
///
/// Kitaigorodskii's definition is 1 for wh >= 2.
/// [SOURCE: Bouws et al. 1985 (TMA); Horvath 2015]
float SeaKitaigorodskii(float omega, float h)
{
    float omegaH = omega * sqrt(h / SEA_G);

    if (omegaH <= 1.0) return 0.5 * omegaH * omegaH;
    if (omegaH <  2.0) return 1.0 - 0.5 * (2.0 - omegaH) * (2.0 - omegaH);
    return 1.0;
}

/// DIRECTIONAL SPREADING NORMALIZATION CONSTANT Q(s).
///
/// Q(s) = Gamma(s+1) / (2 sqrt(pi) Gamma(s+1/2)); HLSL has no gamma
/// function. The paper gives a piecewise polynomial approximation of it.
/// [SOURCE: Horvath 2015 — normalization factor approximation]
float SeaSpreadNorm(float s)
{
    float s2 = s * s;
    float s3 = s2 * s;
    float s4 = s3 * s;

    if (s < 5.0)
        return -0.000564 * s4 + 0.00776 * s3 - 0.044 * s2 + 0.192 * s + 0.163;

    return -4.80e-8 * s4 + 1.07e-5 * s3 - 9.53e-4 * s2 + 5.90e-2 * s + 3.93e-1;
}

/// DIRECTIONAL SPREADING D(omega, theta). [SOURCE: Horvath 2015]
float SeaDirectionalSpread(float omega, float omegaP, float theta,
                           float thetaWind, float u10, float swell)
{
    float ratio = omega / omegaP;

    float s;
    if (ratio < 1.05)
    {
        s = 6.97 * pow(ratio, 4.06);
    }
    else
    {
        float mu = -2.33 - 1.45 * (u10 * omegaP / SEA_G - 1.17);
        s = 9.77 * pow(ratio, mu);
    }

    // Swell fraction: stretches the waves into parallel trains.
    s += 16.0 * tanh(ratio) * swell * swell;

    float halfAngle = 0.5 * (theta - thetaWind);
    return SeaSpreadNorm(s) * pow(max(abs(cos(halfAngle)), 1e-6), 2.0 * s);
}

/// SWELL — THE SECOND PEAK OF THE SPECTRUM.
///
/// A real open coast is never dead calm: waves generated by storms hundreds
/// of kilometres away arrive as long, slow, narrow-crested swell that has
/// NOTHING to do with the local wind. Measured on this sea before the swell
/// existed: with the wind at the shore 0.62 m/s the JONSWAP peak wavelength
/// was 2.3 m and the period 1.22 s — the whole sea was one uniform ripple.
///
/// The shape is JONSWAP's, with two differences: the peak is set directly by
/// a period (a distant storm's swell does not follow the local fetch), and
/// gamma is high so the band is narrow. The energy is not derived from a
/// fetch either — it is given as an alpha, because what sets a swell's height
/// is a storm we are not simulating.
///
/// [SOURCE: double-peaked wind sea + swell spectrum, Coastal Wiki /
///  Statistical description of wave parameters]
float SeaSwellSpectrum(float omega, float omegaP, float gamma)
{
    float sigma = omega <= omegaP ? SEA_JONSWAP_SIGMA_LO : SEA_JONSWAP_SIGMA_HI;
    float delta = omega - omegaP;
    float r     = exp(-(delta * delta) / (2.0 * sigma * sigma * omegaP * omegaP));

    float w4 = omegaP / omega;
    w4 = w4 * w4 * w4 * w4;

    return (SEA_G * SEA_G / pow(omega, 5.0))
         * exp(-1.25 * w4)
         * pow(gamma, r);
}

/// Cosine-2s spreading around a given direction, with a FIXED exponent.
/// The wind sea's `s` follows the frequency (Horvath); a swell's does not —
/// it arrives from one direction at every frequency.
float SeaFixedSpread(float theta, float thetaMean, float s)
{
    float halfAngle = 0.5 * (theta - thetaMean);
    return SeaSpreadNorm(s) * pow(max(abs(cos(halfAngle)), 1e-6), 2.0 * s);
}

/// d(omega)/dk, from the derivative of omega^2 = g k tanh(kD).
float SeaDOmegaDk(float k, float depth, float omega)
{
    // Same clamp as in `SeaOmega`: `cosh` also expands through e^x.
    float kd = min(k * depth, 20.0);
    float th = tanh(kd);
    float ch = cosh(kd);

    return (SEA_G * th + SEA_G * kd / (ch * ch)) / (2.0 * max(omega, 1e-6));
}

// -------------------------------------------------------- KInitialSpectrum

/// Amplitude squared Ph(k) * dk^2 for one wave vector.
///
/// Ph(k) = S_TMA(omega, h) * D(omega, theta) * (domega/dk) / k   (spec 6.3)
/// The dkx*dkz factor is added for the discrete FFT amplitude.
float SeaSpectrumPower(float2 k, float patchSize, float2 wind, uint tier)
{
    float kLen = length(k);
    if (kLen < 1e-6) return 0.0;

    // TIER BAND. If all three tiers carried the same k range the energy would
    // be counted three times. The rule: a tier carries a wavelength only if
    // AT LEAST FOUR full periods fit in its patch (lambda <= L/4); anything
    // longer is handed to a coarser tier. The four is a [CALIBRATION].
    float upper = _SeaTierCutoffK[tier];
    float lower = tier == 0u ? 0.0 : _SeaTierCutoffK[max(tier, 1u) - 1u];
    if (kLen < lower || kLen >= upper) return 0.0;

    float u10 = max(length(wind), 0.5);
    float thetaWind = atan2(wind.y, wind.x);
    float theta = atan2(k.y, k.x);

    float omega  = SeaOmega(kLen, _SeaSpectrumDepth);
    float omegaP = SeaPeakOmega(u10, _SeaFetch);

    // WIND SEA — the local wind and the local fetch.
    float sWind = SeaJonswap(omega, omegaP, u10, _SeaFetch)
                * SeaKitaigorodskii(omega, _SeaSpectrumDepth)
                * SeaDirectionalSpread(omega, omegaP, theta, thetaWind, u10, _SeaSwell);

    // SWELL — distant storms. Its own peak, its own direction, its own energy.
    // It does not fall to zero when the wind does, which is why the sea stays
    // alive in calm weather; and because its peak is many times longer than
    // the wind sea's, the two together give waves of DIFFERENT SIZES rather
    // than one uniform field.
    float thetaSwell = thetaWind + _SeaSwellDirOffset;

    float sSwell = _SeaSwellAlpha
                 * SeaSwellSpectrum(omega, _SeaSwellPeakOmega, _SeaSwellGamma)
                 * SeaKitaigorodskii(omega, _SeaSpectrumDepth)
                 * SeaFixedSpread(theta, thetaSwell, _SeaSwellSpreadS);

    float ph = (sWind + sSwell) * SeaDOmegaDk(kLen, _SeaSpectrumDepth, omega) / kLen;

    // Small wave suppression. [SOURCE: Tessendorf 2004 equation 41]
    float l = _SeaSmallWaveCutoff;
    ph *= exp(-kLen * kLen * l * l);

    float dk = SEA_TWO_PI / patchSize;
    return max(ph, 0.0) * dk * dk;
}

[numthreads(8, 8, 1)]
void KInitialSpectrum(uint3 id : SV_DispatchThreadID)
{
    uint N = _SeaFftSize;
    if (id.x >= N || id.y >= N) return;

    uint tier = id.z;
    float patchSize = _SeaPatchSizes[tier];

    float dk = SEA_TWO_PI / patchSize;

    // The n, m indices run over -N/2 .. N/2-1 (spec 6.1).
    float2 n = float2(id.xy) - (float)(N / 2u);
    float2 k = n * dk;

    uint2 mirror = (N - id.xy) % N;
    float2 nMirror = float2(mirror) - (float)(N / 2u);
    float2 kMirror = nMirror * dk;

    // THE MIRROR TEXEL'S SEED MUST COME FROM THE SAME FORMULA.
    //
    // For h(x) to be real we need h~(-k) = conj(h~(k)). That only holds if
    // the value texel k uses as "h0(-k)" is EXACTLY the value texel -k writes
    // into its own xy. With a separate seed block the relation breaks and the
    // surface is not real — mean(h) drifts away from zero (spec 6.8
    // acceptance criterion).
    uint seedA = ((tier * N + id.y)     * N + id.x)     * 4u;
    uint seedB = ((tier * N + mirror.y) * N + mirror.x) * 4u;

    float2 xiA = SeaGauss(seedA);
    float2 xiB = SeaGauss(seedB);

    // h0(k) = (1/sqrt(2)) (xi_r + i xi_i) sqrt(Ph(k))   (spec 6.1)
    float2 h0       = (1.0 / sqrt(2.0)) * xiA
                    * sqrt(SeaSpectrumPower(k,       patchSize, _SeaWindWS, tier));
    float2 h0Mirror = (1.0 / sqrt(2.0)) * xiB
                    * sqrt(SeaSpectrumPower(kMirror, patchSize, _SeaWindWS, tier));

    _SeaH0RW[uint3(id.xy, tier)] = float4(h0, SeaConj(h0Mirror));
}

// ----------------------------------------------------------- KTimeSpectrum

[numthreads(8, 8, 1)]
void KTimeSpectrum(uint3 id : SV_DispatchThreadID)
{
    uint N = _SeaFftSize;
    if (id.x >= N || id.y >= N) return;

    uint tier = id.z;
    float dk = SEA_TWO_PI / _SeaPatchSizes[tier];

    float2 k = (float2(id.xy) - (float)(N / 2u)) * dk;
    float kLen = length(k);

    float4 h0Pair = _SeaH0RW[uint3(id.xy, tier)];

    // LOOP QUANTIZATION IS MANDATORY (spec 6.5): every frequency must be a
    // multiple of the fundamental so the field repeats every T seconds and
    // float precision survives a long session.
    float omega = SeaQuantizeOmega(SeaOmega(kLen, _SeaSpectrumDepth));

    float2 phase = SeaExpI(omega * _SeaTime);

    // h(k,t) = h0(k) e^{iwt} + h0*(-k) e^{-iwt}
    // This form preserves the conjugate property; break it and the surface
    // stays flat.
    float2 ht = SeaCMul(h0Pair.xy, phase) + SeaCMul(h0Pair.zw, SeaConj(phase));

    float2 unit = kLen < 1e-6 ? float2(0.0, 0.0) : k / kLen;

    // THE SLOPE IS NOT COMPUTED BY FINITE DIFFERENCE (spec 6.7): a finite
    // difference approximates the slope badly at short wavelengths.
    //   slope        : i k h
    //   dispX/dispZ  : -i (k/|k|) h
    //   dDx/dx       : i kx * dispX = (kx^2 / |k|) h      (a real coefficient)
    //   dDz/dz       : (kz^2 / |k|) h
    //   dDx/dz       : (kx kz / |k|) h
    float2 slopeX = SeaCMul(float2(0.0, k.x), ht);
    float2 slopeZ = SeaCMul(float2(0.0, k.y), ht);

    float2 dispX = SeaCMul(float2(0.0, -unit.x), ht);
    float2 dispZ = SeaCMul(float2(0.0, -unit.y), ht);

    float invK = kLen < 1e-6 ? 0.0 : 1.0 / kLen;
    float2 dDxdx = ht * (k.x * k.x * invK);
    float2 dDzdz = ht * (k.y * k.y * invK);
    float2 dDxdz = ht * (k.x * k.y * invK);

    // Packing: C = A + i*B.
    _SeaSpectrumHtRW[uint3(id.xy, tier)] = float4(
        dispX.x - dispZ.y, dispX.y + dispZ.x,
        ht.x    - dDxdz.y, ht.y    + dDxdz.x);

    _SeaSpectrumSlopeRW[uint3(id.xy, tier)] = float4(
        slopeX.x - slopeZ.y, slopeX.y + slopeZ.x,
        dDxdx.x  - dDzdz.y,  dDxdx.y  + dDzdz.x);
}
