// KAR DEFORMASYON TAMPONU. Oyuncunun etrafındaki yerel yüksek çözünürlüklü izler.
//
// NEDEN AYRI SİSTEM. Kar örtüsü simülasyonunun hücresi arazi ızgarasıyla aynı
// (7.32 m); ayak izi 0.3 m. Cordonnier makalesi bunu kendisi söylüyor: "10m per cell
// only allows a consideration of the general direction of the skiers" (§6.2). İz o
// ızgaraya sığmaz, kendi dokusunda yaşar.
//
// DOKU DÜNYAYA DÖŞENİYOR, KAYDIRILMIYOR. `uv = worldPos.xz / Extent` ve doku Repeat
// sarımlı: doku dünyayı `Extent` periyoduyla döşüyor. Oyuncu yürürken hiçbir kopyalama
// yapılmıyor, yalnız pencereye YENİ GİREN şeritler sıfırlanıyor. Klasik "kaydır ve
// kopyala" yönteminin her kare bir tam doku kopyası vardı.
//
// Pencere `Extent` kenarlı kare, görünür bölge ise yarıçapı `Extent/2` olan çember.
// Çember kareye içten teğet olduğu için döşemenin komşu kopyası hiçbir zaman
// görünmüyor — sönüm 12 m'de bitiyor, kare köşesi 17 m'de.
//
// DEĞER İŞARETLİ: pozitif = yüzey ÇÖKMÜŞ (oluğun tabanı), negatif = KABARMIŞ
// (oluğun kenarına itilen kar). Geri dolma ikisini de sıfıra çekiyor.

#pragma kernel Stamp
#pragma kernel ClearStrip
#pragma kernel Refill

RWTexture2D<float> _Deform;

uint  _Resolution;
uint  _ResolutionMask;   // _Resolution - 1, ikinin kuvveti olduğu C# tarafında doğrulanıyor
float _TexelSize;        // metre / texel

// --- iz parçası (süpürülmüş kapsül) ---
float2 _StampFrom;       // dünya xz, parçanın başı
float2 _StampTo;         // dünya xz, parçanın sonu
float  _StampHalfWidth;  // oluğun yarı genişliği, metre
float  _StampDepth;      // oluk tabanının çökmesi, metre
int2   _StampOrigin;     // işlenecek kutunun mutlak texel köşesi
int2   _StampSize;       // kutunun texel boyu

// --- şerit temizleme ---
int2 _ClearOrigin;       // mutlak texel indeksi
int2 _ClearSize;

// --- geri dolma ---
float _RefillAmount;     // metre, bu adımda sıfıra doğru kapanan miktar

/// DÜNYA UZAYINDA GÜRÜLTÜ. Desen ize değil dünyaya bağlı: iz uzarken kayma olmuyor,
/// aynı yerden ikinci geçişte aynı düzensizlik çıkıyor.
///
/// KARMA TAM SAYI ARİTMETİĞİYLE. `sin(dot(...))*43758` biçimi platformdan platforma,
/// hatta derleyiciden derleyiciye kayıyor ve ızgaraya hizalı yapı bırakıyor — bu
/// projede bir kez ölçüldü (`SnowDriftField` başlığı). Tam sayı karması her yerde aynı
/// ve ızgara izi bırakmıyor.
uint DeformWang(uint seed)
{
    seed = (seed ^ 61u) ^ (seed >> 16);
    seed *= 9u;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2du;
    seed = seed ^ (seed >> 15);
    return seed;
}

float DeformHash(float2 cell)
{
    int2 c = (int2)cell;
    uint seed = DeformWang((uint)(c.x * 73856093) ^ (uint)(c.y * 19349663));
    return (seed & 0xFFFFFFu) / 16777215.0;
}

float DeformNoise(float2 pos, float cellSize)
{
    float2 g = pos / cellSize;
    float2 i = floor(g);
    float2 f = g - i;
    float2 u = f * f * (3.0 - 2.0 * f);

    float a = DeformHash(i);
    float b = DeformHash(i + float2(1.0, 0.0));
    float c = DeformHash(i + float2(0.0, 1.0));
    float d = DeformHash(i + float2(1.0, 1.0));

    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

/// ÇOK OKTAV. Tek oktavlı değer gürültüsünün KARAKTERİSTİK BİR BOYU var ve göz onu
/// "aynı desen" diye yakalıyor — kullanıcı "sürekli aynı dağılmayı görüyorum, her
/// yerde aynı bulutlar gibi" dedi. Oktavlar o tek boyu siliyor.
///
/// Her oktav 2.17 kat sıklaşıyor, tam iki değil: tam sayı oranlarında oktavların
/// sıfırları üst üste biniyor ve ızgara geri geliyor.
float DeformFbm(float2 pos, float cellSize, int octaves)
{
    float sum = 0.0;
    float weight = 0.0;
    float amplitude = 1.0;
    float scale = cellSize;

    for (int i = 0; i < octaves; i++)
    {
        sum += DeformNoise(pos + (float)i * 41.7, scale) * amplitude;
        weight += amplitude;
        scale /= 2.17;
        amplitude *= 0.55;
    }

    return sum / max(weight, 1e-4);
}

/// ALAN BÜKÜMÜ. Gürültü kendi ızgarasında örnekleniyor ve o ızgara ne kadar iyi
/// gizlense de düzenli; örnekleme KONUMU başka bir gürültüyle kaydırılınca desen
/// kendi ızgarasından kopuyor. Projede aynı yöntem birikinti alanında da var
/// (`SnowDrift.hlsl`, `warp` ve `fineWarp`).
///
/// Büküm ölçeği izden büyük (1.6 m): küçük olsaydı deseni bozmak yerine titretirdi.
float2 DeformWarp(float2 world)
{
    float2 offset = float2(DeformFbm(world + 5.0, 1.6, 2),
                           DeformFbm(world - 8.0, 1.6, 2)) - 0.5;
    return world + offset * 0.9;
}

uint2 Slot(int2 absolute)
{
    // Toroidal yuva. Tam sayı modülü yerine BİT MASKESİ: çözünürlük ikinin kuvveti
    // ve `%` derleyicinin uyardığı kadar yavaş. Kuvvet olmadığı durum C# tarafında
    // fırlatılıyor (`SnowDeformation.OnEnable`), yani burada sessiz bozulma yok.
    //
    // Maske negatif indekste de doğru: ikinin tümleyeninde `-1 & 511 == 511`, yani
    // sarma kendiliğinden pozitife düşüyor.
    return (uint2)(absolute & (int)_ResolutionMask);
}

[numthreads(8, 8, 1)]
void Stamp(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _StampSize.x || (int)id.y >= _StampSize.y) return;

    int2 absolute = _StampOrigin + int2(id.xy);
    float2 world = ((float2)absolute + 0.5) * _TexelSize;

    // NOKTAYA DEĞİL PARÇAYA UZAKLIK. İz ayrık ayak basımı değil, gövdenin karı
    // yararak açtığı SÜREKLİ OLUK: her karede kat edilen yol bir doğru parçası
    // olarak süpürülüyor. Ayrık damga bırakılsaydı hızlı giderken oluk kopardı.
    float2 seg = _StampTo - _StampFrom;
    float len2 = dot(seg, seg);
    float t = len2 > 1e-8 ? saturate(dot(world - _StampFrom, seg) / len2) : 0.0;
    float dist = distance(world, _StampFrom + seg * t);

    float r = dist / max(_StampHalfWidth, 1e-4);

    // Bütün düzensizlik BÜKÜLMÜŞ koordinatta okunuyor: gürültünün kendi ızgarası
    // böylece deseni ele vermiyor.
    float2 warped = DeformWarp(world);

    // KENAR DÜZENSİZ. Matematiksel kapsül ekranda kalıptan çıkmış gibi duruyordu:
    // gerçek izin kıyısı granüler, kar öbek öbek kopuyor. Kenar dünya uzayında bir
    // gürültüyle bozuluyor — desen ize değil DÜNYAYA bağlı, yani iz uzarken kayma
    // olmuyor.
    //
    // Ölçek 12 cm: texel 4.7 cm ve bölünmüş üçgen 11.4 cm, yani bundan ince bir
    // düzensizlik geometriye ulaşamaz. Genlik yarıçapın beşte biri.
    // KENAR DAĞILIYOR — bükülmüş koordinatta, çok oktavlı.
    //
    // Üç ölçek: 40 cm duvarın göçtüğü büyük loblar, 15 cm kopan öbekler, 6 cm tane.
    // Hücre 4.7 cm, yani bundan incesi geometriye ulaşmaz.
    // Ölçekler oluğun genişliğine göre: 40 cm'lik oluğun kenarında 40 cm'lik bir lob
    // "düzensizlik" değil, oluğun kendisinin eğrilmesi olur.
    float edge = (DeformFbm(warped, 0.22, 3) - 0.5) * 0.30
               + (DeformFbm(warped + 37.0, 0.09, 2) - 0.5) * 0.16
               + (DeformFbm(warped - 61.0, 0.05, 2) - 0.5) * 0.08;
    r *= 1.0 + edge;

    // ---- TABAN: DÜZ DEĞİL, KIRIK ----
    //
    // Oluk sabit derinlikte bir kanal olarak okunuyordu. Gerçek izde iki şey değişiyor:
    //
    //   ADIM NABZI (55 cm) — her basış farklı sıkıştırıyor, derinlik yol boyunca
    //     dalgalanıyor.
    //   KIRIK TABAN (12 cm) — kar öbek öbek çöküyor, taban pürüzlü kalıyor.
    //
    // Hepsi BÜKÜLMÜŞ koordinatta ve çok oktavlı: tek oktav + düz koordinat "aynı desen
    // her yerde" veriyordu.
    float stride = 0.72 + 0.5 * DeformFbm(warped + 17.0, 0.55, 2);
    float broken = 0.78 + 0.44 * DeformFbm(warped - 29.0, 0.12, 3);
    float depth = _StampDepth * stride * broken;

    float floorMask = 1.0 - smoothstep(0.25, 1.1, r);

    // ---- YANA SAÇILAN KAR ----
    //
    // Kar yana itilirken eşit yayılmıyor: öbekler halinde savruluyor.
    //
    // BANT 2.2 KAT, ÖBEK ÖLÇEĞİ BANDA GÖRE.
    //
    // Gürültü ölçekleri METRE cinsinden sabit; bant daraltılınca öbek gürültüsünün
    // hücresi (34 cm) bandın kendisinden (18 cm) büyük kaldı ve bant boyunca değeri
    // neredeyse sabit çıktı: öbek yerine düz şerit. Kullanıcı "dağılma bozuldu" dedi.
    //
    // Kural: öbek hücresi bandın genişliğinin yarısı kadar olmalı, yoksa bandın içine
    // birkaç öbek sığmaz.
    //
    // KAPI YUMUŞAK. Dar bir eşik (0.52-0.82) öbeklerin kenarını keskin kesiyordu ve
    // hepsi aynı boyda çıkıyordu; geniş eşik hem yumuşak kenar hem değişken boy veriyor.
    float scatterBand = (1.0 - smoothstep(1.0, 2.2, r)) * smoothstep(0.86, 1.08, r);
    float clumpGate = smoothstep(0.38, 0.92, DeformFbm(warped + 211.0, 0.13, 3));
    float grainGate = 0.5 + 1.0 * DeformFbm(warped - 97.0, 0.05, 2);

    float scatterValue = depth * 0.26 * scatterBand * clumpGate * grainGate;
    float floorValue = depth * floorMask;

    uint2 slot = Slot(absolute);
    float previous = _Deform[slot];

    // SAÇILAN KAR, AÇILMIŞ OLUĞU SİLEMEZ.
    //
    // Bir dönem tek bir işaretli değer yazılıyordu ve negatifler `min` dalına
    // düşüyordu: yeni parçanın seti, bir önceki parçanın TABANINI (pozitif) görüp
    // yerine kabarma yazıyordu. Ekranda düzenli tırtıklı bir dizi çıkıyordu.
    //
    // Doğru kural: taban her zaman kazanır, saçılan kar yalnız DOKUNULMAMIŞ kara
    // yığılır.
    float value;
    if (floorValue > 1e-5)
        value = max(previous, floorValue);
    else if (scatterValue > 1e-5)
        value = previous > 1e-5 ? previous : min(previous, -scatterValue);
    else
        return;

    _Deform[slot] = value;
}

[numthreads(8, 8, 1)]
void ClearStrip(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _ClearSize.x || (int)id.y >= _ClearSize.y) return;
    _Deform[Slot(_ClearOrigin + int2(id.xy))] = 0.0;
}

[numthreads(8, 8, 1)]
void Refill(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution) return;

    float v = _Deform[id.xy];
    if (v == 0.0) return;

    // Sıfıra doğru sabit hızla kapanma. Çarpımsal sönüm derin izi sığ izden hızlı
    // kapatırdı; gerçekte dolan şey hacim, oran değil.
    float closed = v > 0.0 ? max(0.0, v - _RefillAmount)
                           : min(0.0, v + _RefillAmount);
    _Deform[id.xy] = closed;
}
