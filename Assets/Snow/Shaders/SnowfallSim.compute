// ROLE: the GPU simulation of the snowflakes and the ground drift (spec §17.1).
// CALLED BY: SnowfallRenderer.

#pragma kernel KFlakeUpdate
#pragma kernel KDriftUpdate

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "SnowCommon.hlsl"

/// Tek tanenin durumu. 12 float = 48 bayt; 40 000 tane 1.9 MB.
struct SnowFlake
{
    float3 position;
    float  age;
    float3 velocity;
    float  lifetime;      // <= 0 → this slot is off
    float  size;
    float  phase;
    float  frame;         // atlas karesi 0..15
    float  alpha;
};

RWStructuredBuffer<SnowFlake> _Flakes;

uint  _FlakeCapacity;

/// THE NUMBER OF OPEN SLOTS. The density is tuned with it: particles with
/// `i < _FlakeAliveCount` cycle forever, the rest stay off.
///
/// The classic "give birth to this many per frame" route needs a counter and atomics;
/// this route needs neither and the volume fills IN THE FIRST FRAME (spec §17.1
/// "spawn into the whole box").
uint  _FlakeAliveCount;

float3 _SpawnCenter;
float3 _SpawnExtent;

float  _FlakeBaseSize;
float  _FlakeSeed;

/// The integer seed of the birth hash. `_FlakeSeed` stays for shifting the turbulence
/// field; the hash no longer feeds from it.
uint   _FlakeSeedU;

float  _SnowWetness;
float  _SnowDeltaTime;

/// Turbulence (spec §17.1): the strength rises with the wind.
float  _TurbulenceIntensity;
float  _TurbulenceFrequency;
float  _TurbulenceDrag;

float  _FlutterFreq;
float  _FlutterAmp;

/// Ground drift (spec §17.1 System B).
float3 _DriftOrigin;
float  _DriftStripLength;
float  _DriftStripWidth;

// ------------------------------------------------------------------- rastgele

/// The particle birth randomness. All of it from an integer hash — `frac(sin(...))`
/// collapsed at a hundred thousand indices (`SnowCommon.hlsl` → `SnowPcg3d`).
float3 SnowRand3(uint idx, uint slot)
{
    return SnowRandU3(uint3(idx, _FlakeSeedU, slot));
}

/// The grid corner of the value noise. The cell is an integer; the same quality at the
/// mountain's summit and at its foot.
float SnowRand(int3 cell) { return SnowRandCell3(cell).x; }

// ------------------------------------------------------------------ turbulence

float SnowValueNoise(float3 p)
{
    int3 i = (int3)floor(p);
    float3 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);

    float n000 = SnowRand(i + int3(0, 0, 0));
    float n100 = SnowRand(i + int3(1, 0, 0));
    float n010 = SnowRand(i + int3(0, 1, 0));
    float n110 = SnowRand(i + int3(1, 1, 0));
    float n001 = SnowRand(i + int3(0, 0, 1));
    float n101 = SnowRand(i + int3(1, 0, 1));
    float n011 = SnowRand(i + int3(0, 1, 1));
    float n111 = SnowRand(i + int3(1, 1, 1));

    return lerp(lerp(lerp(n000, n100, f.x), lerp(n010, n110, f.x), f.y),
                lerp(lerp(n001, n101, f.x), lerp(n011, n111, f.x), f.y), f.z);
}

/// A two-octave vector field (spec §17.1: Octaves = 2).
float3 SnowTurbulence(float3 p)
{
    float3 a = float3(SnowValueNoise(p),
                      SnowValueNoise(p + 19.7),
                      SnowValueNoise(p + 43.3)) * 2.0 - 1.0;

    float3 b = float3(SnowValueNoise(p * 2.13 + 7.1),
                      SnowValueNoise(p * 2.13 + 31.9),
                      SnowValueNoise(p * 2.13 + 57.4)) * 2.0 - 1.0;

    return a + b * 0.5;
}

// -------------------------------------------------------------------- cover

/// The world Y of the cover above this point. A very low value if there is no cover.
float SnowOcclusionY(float3 posWS)
{
    float2 uv = (posWS.xz - _SkyCenterXZ) / _SkyAreaSize + 0.5;
    if (any(uv < 0.0) || any(uv > 1.0)) return -9999.0;

    return SAMPLE_TEXTURE2D_LOD(_SnowSkyVisTex, sampler_LinearClamp, uv, 0).r;
}

// ------------------------------------------------------------------ kar tanesi

void SpawnFlake(uint idx, inout SnowFlake f)
{
    float3 r0 = SnowRand3(idx, 1u);
    float3 r1 = SnowRand3(idx, 2u);

    // THE SPAWN BOX IS SNAPPED TO A 1 m GRID (on the CPU). Without the snap the birth
    // pattern walks as the camera moves and the particles look like they are sliding.
    f.position = _SpawnCenter + (r0 * 2.0 - 1.0) * _SpawnExtent;

    f.age = 0.0;
    f.lifetime = lerp(4.0, 9.0, r1.x);

    // The terminal velocity rises with the wetness: wet snow is heavy and falls fast.
    float dry = lerp(0.6, 1.4, r1.y);
    float wet = lerp(1.4, 3.0, r1.z);
    float terminal = lerp(dry, wet, _SnowWetness);

    f.velocity = _WindWS + float3(0.0, -terminal, 0.0);

    f.size = _FlakeBaseSize * lerp(0.6, 1.7, r0.y);
    f.phase = r0.z * 6.2831853;
    f.frame = floor(r1.x * 16.0);
    f.alpha = 0.0;
}

[numthreads(64, 1, 1)]
void KFlakeUpdate(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _FlakeCapacity) return;

    SnowFlake f = _Flakes[idx];

    // A closed slot: no work at all.
    if (idx >= _FlakeAliveCount)
    {
        f.lifetime = 0.0;
        f.alpha = 0.0;
        _Flakes[idx] = f;
        return;
    }

    bool respawn = f.lifetime <= 0.0 || f.age >= f.lifetime;

    if (!respawn)
    {
        // GROUND CULL (spec §17.1).
        if (f.position.y < SampleGroundHeight(f.position.xz) + 0.02) respawn = true;

        // COVER CULL. Snow not falling under a roof/bridge is the most noticeable
        // detail (spec §17.1 — "not to be skipped").
        if (SnowOcclusionY(f.position) - f.position.y > 1.5) respawn = true;
    }

    if (respawn)
    {
        SpawnFlake(idx, f);
        _Flakes[idx] = f;
        return;
    }

    float dt = _SnowDeltaTime;

    f.age += dt;

    float3 target = _WindWS + float3(0.0, f.velocity.y, 0.0);
    float3 turb = SnowTurbulence(f.position * _TurbulenceFrequency + _FlakeSeed) *
                  _TurbulenceIntensity;

    // Drag: an exponential approach towards the speed. No sudden jump.
    f.velocity = lerp(f.velocity, target + turb, 1.0 - exp(-_TurbulenceDrag * dt));

    f.position += f.velocity * dt;

    // OSCILLATION: the particle does not fall straight, it swings horizontally. It dies out in wet snow.
    float2 flutter = float2(sin(f.age * _FlutterFreq + f.phase),
                            cos(f.age * _FlutterFreq * 0.83 + f.phase));

    f.position.xz += flutter * _FlutterAmp * (1.0 - _SnowWetness) * dt;

    // An alpha ramp over the first and last 8% of the lifetime — the particles do not appear suddenly.
    float t = saturate(f.age / max(f.lifetime, 1e-3));
    float life = saturate(t / 0.08) * saturate((1.0 - t) / 0.08);

    // A soft transition at the fringe.
    float occl = 1.0 - smoothstep(0.0, 0.5, SnowOcclusionY(f.position) - f.position.y);

    f.alpha = life * occl;

    _Flakes[idx] = f;
}

// -------------------------------------------------------------- ground drift

/// THE SALTATION LAYER IS 1–5 cm (spec §18.7) [SOURCE: Pomeroy & Gray 1990].
/// Giving birth higher is the suspension layer and a separate system.
void SpawnDrift(uint idx, inout SnowFlake f)
{
    float3 r0 = SnowRand3(idx, 11u);
    float3 r1 = SnowRand3(idx, 12u);

    float2 wind = normalize(_WindWS.xz + 1e-5);
    float2 side = float2(-wind.y, wind.x);

    // It is born in a strip UPWIND and comes towards the camera with the wind.
    float2 planar = _DriftOrigin.xz
                  - wind * (r0.x * _DriftStripLength)
                  + side * ((r0.y * 2.0 - 1.0) * _DriftStripWidth);

    float groundY = SampleGroundHeight(planar);

    f.position = float3(planar.x, groundY + r0.z * 0.05, planar.y);

    f.age = 0.0;
    f.lifetime = lerp(1.2, 3.0, r1.x);

    f.velocity = _WindWS * lerp(0.7, 1.1, r1.y) + float3(0.0, lerp(0.2, 0.8, r1.z), 0.0);

    f.size = _FlakeBaseSize * lerp(0.8, 1.6, r0.y);
    f.phase = r0.z * 6.2831853;
    f.frame = floor(r1.x * 16.0);
    f.alpha = 0.0;
}

[numthreads(64, 1, 1)]
void KDriftUpdate(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _FlakeCapacity) return;

    SnowFlake f = _Flakes[idx];

    if (idx >= _FlakeAliveCount)
    {
        f.lifetime = 0.0;
        f.alpha = 0.0;
        _Flakes[idx] = f;
        return;
    }

    if (f.lifetime <= 0.0 || f.age >= f.lifetime)
    {
        SpawnDrift(idx, f);
        _Flakes[idx] = f;
        return;
    }

    float dt = _SnowDeltaTime;

    f.age += dt;
    f.position += f.velocity * dt;

    float groundY = SampleGroundHeight(f.position.xz);

    // It fades as it rises from the ground: saltation is a layer hugging the surface.
    float height = f.position.y - groundY;
    float fade = 1.0 - saturate(height / 0.30);

    float t = saturate(f.age / max(f.lifetime, 1e-3));
    float life = saturate(t / 0.15) * saturate((1.0 - t) / 0.25);

    f.alpha = fade * life;

    _Flakes[idx] = f;
}

// ------------------------------------------------------------------ patlamalar

#pragma kernel KBurstUpdate

/// Patlama tipi parcaciklar: ayak tozu (spec 19.3) ve kar puskurtme
/// (spec 18.6). Ikisi de kisa omurlu, yercekimiyle dusen, ruzgarla
/// suruklenen ve dagilarak buyuyen tanelerdir; tek kernel yetiyor.
float _BurstGravity;
float _BurstDrag;
float _BurstWindPull;
float _BurstGrowth;

[numthreads(64, 1, 1)]
void KBurstUpdate(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _FlakeCapacity) return;

    SnowFlake f = _Flakes[idx];

    // Olu yuva: hicbir sey yapilmiyor. Doguran taraf CPU (SnowBurstParticles).
    if (f.lifetime <= 0.0) return;

    float dt = _SnowDeltaTime;

    f.age += dt;

    if (f.age >= f.lifetime)
    {
        f.lifetime = 0.0;
        f.alpha = 0.0;
        _Flakes[idx] = f;
        return;
    }

    // KAR TANESI HAFIF: yercekimi kisilmis, suruklenme baskin (spec 18.6).
    f.velocity.y += _BurstGravity * dt;
    f.velocity += _WindWS * _BurstWindPull * dt;
    f.velocity *= exp(-_BurstDrag * dt);

    f.position += f.velocity * dt;

    // It dies on hitting the ground; it does not bounce - the lifetime is short anyway.
    float groundY = SampleGroundHeight(f.position.xz);
    if (f.position.y < groundY) f.position.y = groundY;

    float t = saturate(f.age / max(f.lifetime, 1e-3));

    f.size *= 1.0 + _BurstGrowth * dt;
    f.alpha = saturate(t / 0.10) * saturate((1.0 - t) / 0.50);

    _Flakes[idx] = f;
}
