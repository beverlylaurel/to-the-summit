// ROL: kar sisteminin bütün compute kernel'leri. Faz 1'de KClear ve KScroll;
// sonraki fazlar aynı dosyaya kernel ekler.
// Çağıran: SnowRenderPass (tek CommandBuffer içinde, BeforeRenderingOpaques).

#pragma kernel KClear
#pragma kernel KScroll
#pragma kernel KBlurCapture
#pragma kernel KDeform
#pragma kernel KRimBlurH
#pragma kernel KRimBlurV
#pragma kernel KRim
#pragma kernel KAccumulate
#pragma kernel KReduceState
#pragma kernel KFarScroll
#pragma kernel KFarAccumulate
#pragma kernel KBlockPack
#pragma kernel KBlockUnpack

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "SnowCommon.hlsl"

// Ping-pong: aynı doku hem _Src hem _Dst olarak bağlanamaz (spec §20).
Texture2D<float4>   _Src;
RWTexture2D<float4> _Dst;

uint   _Resolution;

/// KAYDIRMA MIKTARI float2 OLARAK BAGLANIYOR. `CommandBuffer`'da tam sayi dizisi
/// baglamanin asiri yuklemesi Unity surumleri arasinda degisiyor; vektor yolu
/// her surumde var. Deger zaten tam sayi, `round` sadece bicimi geri veriyor.
float2 _ScrollTexels;

/// Yeni açılan şeride yazılan değer. RT_Trail için (0,0,0,0), RT_Snow için
/// dünyanın genel kar durumu (spec §6.4).
float4 _NewEdgeValue;

/// KClear'ın yazdığı değer.
float4 _ClearValue;

/// KBlurCapture yarıçapı, teksel.
float _BlurRadiusTexels;

// ---------------------------------------------------------------- iz oluşumu

Texture2D<float4>   _CaptureBlur;
Texture2D<float4>   _Trail;
RWTexture2D<float4> _TrailOut;
Texture2D<float4>   _Snow;
RWTexture2D<float4> _SnowOut;

/// Ayrılabilir blur'un ikinci geçişinin hedefi ve KRim'in kaynağı. Tek kanal.
Texture2D<float>    _BlurredCarve;
RWTexture2D<float>  _CarveOut;

/// TAM HIZLI KERNEL'LERİN dt'si. `_DeltaTimeEff` KAccumulate'in döşeme
/// döndürmesiyle çarpılmış hâlidir (spec §15.2); ikisi karıştırılırsa izler
/// dört kat hızlı dolar.
float _SnowDeltaTime;

float _RimBlurTexels;

/// `SnowfallController` yazıyor. Kar yağmıyorsa 0 ve izler dolmaz — bu doğru
/// davranış (spec §10.3).
float _SnowfallSWERate;

// ------------------------------------------------------------------- birikme

/// Döşeme döndürmesiyle çarpılmış dt (spec §15.2). KAccumulate her karede
/// dokunun 1/_TileCount'unu işliyor.
float _DeltaTimeEff;
uint  _TileIndex;
uint  _TileCount;

/// 64² indirgenmiş durum: R=ortalama swe, G=ortalama rhoN, B=görünür kar oranı.
RWTexture2D<float4> _ReducedOut;

/// Spec §9.4'teki dört nokta birebir.
static const float2 kPoisson4[4] =
{
    float2( 0.3475,  0.0042), float2( 0.8806, -0.3576),
    float2(-0.0640, -0.6415), float2(-0.6178,  0.3813)
};

[numthreads(SNOW_GROUP_SIZE, SNOW_GROUP_SIZE, 1)]
void KClear(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution) return;
    _Dst[id.xy] = _ClearValue;
}

/// BÖLGE KAYDIRMA (spec §6.4).
///
/// Merkez teksel ızgarasında `_ScrollTexels` kadar kaydı; aynı dünya noktası
/// kaynakta o kadar ötede kalıyor, o yüzden `src = id + _ScrollTexels`.
/// Dışarı taşan şerit yeni açılan alandır ve dünyanın genel durumuyla dolar,
/// boş değil.
[numthreads(SNOW_GROUP_SIZE, SNOW_GROUP_SIZE, 1)]
void KScroll(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution) return;

    int2 src = int2(id.xy) + int2(round(_ScrollTexels));
    bool inside = all(src >= 0) && all(src < (int)_Resolution);

    _Dst[id.xy] = inside ? _Src[src] : _NewEdgeValue;
}

/// YAKALAMA BLUR'U — 4-tap bilinear Poisson [KAYNAK: Batman GDC 2014].
///
/// Merkez + dört Poisson tapı, hepsi eşit ağırlıkta (0.2). Poisson dağılımı
/// düzenli bir kernel'in bıraktığı yıldız desenini kırıyor; bilinear örnekleme
/// dört tapı sekiz teksel değerine yayıyor.
[numthreads(SNOW_GROUP_SIZE, SNOW_GROUP_SIZE, 1)]
void KBlurCapture(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution) return;

    float2 uv = (float2(id.xy) + 0.5) / _Resolution;
    float  r  = _BlurRadiusTexels / _Resolution;

    float4 sum = _Src.SampleLevel(sampler_LinearClamp, uv, 0);

    [unroll]
    for (int i = 0; i < 4; ++i)
        sum += _Src.SampleLevel(sampler_LinearClamp, uv + kPoisson4[i] * r, 0);

    _Dst[id.xy] = sum * 0.2;
}

/// İZ OLUŞUMU (spec §10.1) ve İZLERİN DOLMASI (spec §10.3).
///
/// Batma ÖLÇÜLÜYOR: yakalamanın verdiği alt yüzey Y'si ile kar sütununun
/// tepesi arasındaki fark. Basınç formülü, kapsül, damga yok.
[numthreads(SNOW_GROUP_SIZE, SNOW_GROUP_SIZE, 1)]
void KDeform(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution) return;

    float2 worldXZ = SnowTexelToWorld(id.xy);
    float4 cap     = _CaptureBlur[id.xy];
    float4 trail   = _Trail[id.xy];
    float4 snow    = _Snow[id.xy];

    // --- İzlerin dolması (spec §10.3) ---
    // Kar yağmıyor ve rüzgâr 4 m/s altındaysa hiç dolmaz. Yoğunluk KALIR:
    // patika kar dolduktan sonra da belli olur.
    float fillRate = _SnowfallSWERate * SNOW_FILL_GAIN;
    fillRate += max(0.0, _WindSpeed - 4.0) * SNOW_WIND_FILL;

    trail.r = max(0.0, trail.r - fillRate * _SnowDeltaTime);
    trail.g = max(0.0, trail.g - fillRate * _SnowDeltaTime * 1.4);   // sırt daha hızlı erir

    // --- Batma (spec §10.1) ---
    float groundY  = SampleGroundHeight(worldXZ);
    float baseH    = SnowBaseHeight(snow.r, snow.g);
    float snowTopY = groundY + baseH;

    float penetration = 0.0;
    if (cap.a > 0.5)
        penetration = clamp(snowTopY - SnowCaptureY(cap.r), 0.0, baseH);

    if (penetration > 0.0005)
    {
        // --- KABUK KIRILMASI (spec §18.3) [KAYNAK: Cordonnier §5.2, §5.4] ---
        //
        // KABUK PATİKA DEĞİL. Patika trafikten oluşur, kar sütununu boydan
        // boya sıkıştırır ve KIRILMAZ. Kabuk erime-donmadan veya rüzgâr
        // levhasından doğar, yalnız yüzeydeki ince tabakadır, altı gevşek
        // kalır ve yeterli yük binince KIRILIR.
        float crust  = trail.b;
        float packed = saturate((snow.g - SNOW_LOOSE_N) / max(SNOW_PACKED_N - SNOW_LOOSE_N, 1e-3));

        bool onCrust = (crust > SNOW_CRUST_SOLID) && (penetration <= SNOW_CRUST_BREAK_PEN);

        float sinkScale;

        if (onCrust)
        {
            sinkScale = SNOW_CRUST_SINK_SCALE;
        }
        else
        {
            sinkScale = lerp(1.0, SNOW_PACKED_SINK_SCALE, packed);

            // Kırıldı; yeni bir erime-donma çevrimine kadar oluşmuyor.
            if (crust > SNOW_CRUST_SOLID) trail.b = 0.0;
        }

        float target = min(penetration * sinkScale, baseH);

        trail.r = max(trail.r, target);

        float compact = SNOW_COMPACT_RATE * saturate(target / max(baseH, 1e-4));
        snow.g = min(snow.g + compact, SNOW_PACKED_N);
        snow.a = 1.0;
    }

    _TrailOut[id.xy] = trail;
    _SnowOut[id.xy]  = snow;
}

/// AYRILABİLİR KUTU BLUR, yatay geçiş.
///
/// ASSUMPTION: spec §10.2 "iki geçişli separable blur" diyor, ağırlık vermiyor.
/// Tekdüze kutu seçildi — §0.2 gereği en basit çalışan çözüm ve uydurulmuş
/// katsayı getirmiyor. Yarıçap spec'in verdiği `_RimBlurTexels = 7`.
[numthreads(SNOW_GROUP_SIZE, SNOW_GROUP_SIZE, 1)]
void KRimBlurH(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution) return;

    int radius = (int)round(_RimBlurTexels);
    int last   = (int)_Resolution - 1;

    float sum = 0.0;

    [loop]
    for (int k = -radius; k <= radius; ++k)
        sum += _Src[int2(clamp((int)id.x + k, 0, last), id.y)].r;

    _Dst[id.xy] = float4(sum / (2.0 * radius + 1.0), 0.0, 0.0, 0.0);
}

/// Ayrılabilir kutu blur, düşey geçiş. Tek kanala yazıyor.
[numthreads(SNOW_GROUP_SIZE, SNOW_GROUP_SIZE, 1)]
void KRimBlurV(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution) return;

    int radius = (int)round(_RimBlurTexels);
    int last   = (int)_Resolution - 1;

    float sum = 0.0;

    [loop]
    for (int k = -radius; k <= radius; ++k)
        sum += _Src[int2(id.x, clamp((int)id.y + k, 0, last))].r;

    _CarveOut[id.xy] = sum / (2.0 * radius + 1.0);
}

/// KENAR YIĞILMASI (spec §10.2) [KAYNAK: TLOU2, SIGGRAPH 2020].
///
/// `blur(carve) − carve`. Ters yazılırsa sırt izin İÇİNDE oluşur ve iz çukur
/// yerine tümsek görünür (spec §22).
[numthreads(SNOW_GROUP_SIZE, SNOW_GROUP_SIZE, 1)]
void KRim(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution) return;

    float4 trail = _Trail[id.xy];
    float  carve = trail.r;
    float  rim   = trail.g;

    // Sırt hareket yönünde asimetrik olsun diye blur hız kadar kaydırılıyor.
    float2 vel   = _CaptureBlur[id.xy].gb;
    float2 uvOff = -vel * SNOW_RIM_VELOCITY_BIAS / _SnowAreaSize;

    float blurCarve = _BlurredCarve.SampleLevel(sampler_LinearClamp,
                        (float2(id.xy) + 0.5) / _Resolution + uvOff, 0);

    // ERKEN ÇIKIŞ BULANIK CARVE'I DA SORUYOR — ölçülmüş sebeple.
    //
    // ASSUMPTION: spec §15.2 erken çıkışı yalnız `carve` ve `rim`'e bakıyor.
    // Ama §10.2'ye göre sırt tam da carve'ın SIFIR olduğu yerde, izin
    // DIŞINDA oluşuyor. İki madde çelişiyor; §15.2'nin hâli uygulandığında
    // sırt her yerde 0 çıktı (ölçüldü: merkez 0.00 mm, kenar 0.00 mm).
    // Bulanık carve "yakında iz var mı" sorusunun cevabı; optimizasyonun
    // amacı (boş bölgeyi atlamak) korunuyor, sırt yaşıyor.
    if (carve < 0.002 && rim < 0.002 && blurCarve < 0.002)
    {
        _TrailOut[id.xy] = trail;
        return;
    }

    float raised = max(0.0, blurCarve - carve);

    // Sırt yüksekliği MEVCUT KAR DERİNLİĞİYLE ölçekleniyor; atlanırsa sığ karda
    // da derin kardaki kadar sırt çıkar (spec §22).
    float4 snow  = _Snow[id.xy];
    float  baseH = SnowBaseHeight(snow.r, snow.g);
    float  depthScale = saturate(baseH / SNOW_RIM_REF_DEPTH);

    float rimTarget = raised * SNOW_RIM_STRENGTH * depthScale;
    rim = max(rim, min(rimTarget, SNOW_RIM_MAX));

    trail.r = carve;
    trail.g = rim;

    _TrailOut[id.xy] = trail;   // B (kabuk) ve A (sastrugi) korunuyor
}

/// Verilen tekseldeki kar YÜZEYİNİN dünya Y'si. Rüzgâr yeniden dağıtımı için
/// gereken eğim buradan çıkıyor; zemin eğimi de dahil olmalı çünkü kar
/// rüzgâra bakan YAMAÇTA az birikiyor, sadece kendi tümseğinde değil.
float SnowSurfaceWorldY(int2 p)
{
    p = clamp(p, int2(0, 0), int2((int)_Resolution - 1, (int)_Resolution - 1));

    float4 s = _Snow[p];
    float2 w = SnowTexelToWorld((uint2)p);

    return SampleGroundHeight(w) + SnowBaseHeight(s.r, s.g);
}

/// Kar yüzeyinin eğimi (m/m). Spec §11 `SnowHeightGradient` diye çağırıyor
/// ama tanımlamıyor; merkezi fark en basit çalışan karşılığı.
float2 SnowHeightGradient(uint2 id)
{
    float ms = SnowTexelSize();
    int2  p  = int2(id);

    float hR = SnowSurfaceWorldY(p + int2(1, 0));
    float hL = SnowSurfaceWorldY(p - int2(1, 0));
    float hU = SnowSurfaceWorldY(p + int2(0, 1));
    float hD = SnowSurfaceWorldY(p - int2(0, 1));

    return float2(hR - hL, hU - hD) / (2.0 * ms);
}

/// KAR BİRİKMESİ, OTURMASI, ERİMESİ (spec §11)
/// [KAYNAK: Real-time GIS-based snow cover approximation, C&G 2017].
///
/// Sıcaklık GÜNDÖNGÜSÜNDEN geliyor, yağmur MEVCUT yağış sisteminden. Kar
/// sistemi ikisini de üretmiyor, okuyor.
[numthreads(SNOW_GROUP_SIZE, SNOW_GROUP_SIZE, 1)]
void KAccumulate(uint3 id : SV_DispatchThreadID)
{
    // Döşeme döndürmesi: bu karede yalnız bir dikey şerit işleniyor.
    uint tileWidth = _Resolution / max(_TileCount, 1u);
    uint2 pix = uint2(id.x + _TileIndex * tileWidth, id.y);

    if (pix.x >= _Resolution || pix.y >= _Resolution) return;

    float4 s   = _Snow[pix];
    float  rho = SnowDensity(s.g);
    float  dt  = _DeltaTimeEff;

    float2 worldXZ = SnowTexelToWorld(pix);
    float3 posWS   = float3(worldXZ.x,
                            SampleGroundHeight(worldXZ) + SnowBaseHeight(s.r, s.g),
                            worldXZ.y);

    // ---- 1. Yağış ----
    float skyVis = SampleSkyVisibility(posWS);
    float fall   = _SnowfallSWERate * dt * skyVis;

    // Rüzgâr yeniden dağıtımı — rüzgâr MEVCUT sistemden geliyor.
    float2 grad = SnowHeightGradient(pix);
    float3 nrm  = normalize(float3(-grad.x, 1.0, -grad.y));
    float  wDot = dot(nrm, normalize(float3(_WindWS.x, 0.35, _WindWS.z)));

    fall *= lerp(1.0, 1.0 - SNOW_DRIFT_BIAS * wDot, saturate(_WindSpeed / 12.0));
    fall  = max(fall, 0.0);

    float rhoNew = clamp(lerp(55.0, 145.0, s.b) + _WindSpeed * 7.5, 50.0, 320.0);

    float sweNext = s.r + fall;
    rho = (rho * s.r + rhoNew * fall) / max(sweNext, 1e-6);
    s.r = sweNext;

    // ---- 2. Oturma ----
    float rhoTarget = lerp(190.0, 400.0, s.b);
    if (rho < rhoTarget)
        rho += (rhoTarget - rho) * (1.0 - exp(-dt / SNOW_SETTLE_TAU));

    // ---- 3. Erime — derece-gün. Sıcaklık GÜNDÖNGÜSÜNDEN. ----
    float melt = SNOW_MELT_DDF * max(0.0, _TemperatureC);
    melt *= 1.0 + _RainOnSnow01 * SNOW_RAIN_MELT_BOOST;
    s.r = max(0.0, s.r - melt * dt);

    // ---- 4. Islaklık — sıcaklık VE yağmur ----
    float wetTarget = max(saturate(_TemperatureC / 3.0), _RainOnSnow01);
    s.b += (wetTarget - s.b) * (1.0 - exp(-dt / 1800.0));

    if (_RainOnSnow01 > 0.01)
        rho = min(rho + _RainOnSnow01 * 25.0 * dt / 60.0, SNOW_RHO_MAX);

    // ---- 5. Kabuk: erime-donma çimentolanması (spec §18.3) ----
    // [KAYNAK: Cordonnier ve ark., EG 2018, §5.2]
    //
    // ÜÇGEN PROFİL: -20 °C'de sıfır, -5 °C'de TEPE, +5 °C'de yine sıfır.
    // "T < 0 ise kabuk oluşur" yazmak çok soğukta da kabuk üretir ve
    // yanlıştır: kabuk erime-donma ÇEVRİMİNDEN doğuyor, çevrim için de
    // ara sıra erimek gerekiyor.
    float4 trail = _Trail[pix];

    float tempLocal = _TemperatureC;
    float crustGain;

    if (tempLocal <= SNOW_T_FREEZE)
        crustGain = 0.0;
    else if (tempLocal <= SNOW_T_COOL)
        crustGain = (tempLocal - SNOW_T_FREEZE) / (SNOW_T_COOL - SNOW_T_FREEZE);
    else if (tempLocal <= SNOW_T_WARM)
        crustGain = 1.0 - (tempLocal - SNOW_T_COOL) / (SNOW_T_WARM - SNOW_T_COOL);
    else
        crustGain = 0.0;

    // Çevrim için ıslaklık gerekir: tamamen kuru kar çimentolanmaz.
    crustGain *= saturate(s.b * 3.0);

    float crust = trail.b;
    crust += crustGain * SNOW_CRUST_GAIN * dt;

    // Rüzgâr levhası: rüzgâr karı döverek kırılgan kabuk yapıyor (§5.4).
    crust += saturate((_WindSpeed - 8.0) / 8.0) * SNOW_CRUST_WIND_GAIN * (1.0 - s.g) * dt;

    if (tempLocal > SNOW_T_WARM) crust -= dt / SNOW_CRUST_MELT_TAU;

    // Taze kar örtüyor: artık yüzey kabuğu değil.
    crust -= fall * SNOW_CRUST_BURY;

    trail.b = saturate(crust);

    // ---- 6. Tazelik sönümü ----
    s.a *= exp(-dt / SNOW_DISTURB_TAU);

    s.g = SnowDensityN(rho);
    s.r = clamp(s.r, 0.0, SNOW_SWE_MAX);

    _SnowOut[pix]  = s;
    _TrailOut[pix] = trail;
}

/// DURUMU 64²'YE İNDİRGER. `GroundCoverage01` ve `LooseSnowFraction`
/// buradan okunuyor (spec §11, §17.1).
///
/// ASSUMPTION: spec bu kernel'i adlandırmıyor ama §17.1 açıkça "64×64
/// küçültülmüş state" diyor. Tam çözünürlükte geri okuma 8 MB; indirgenmiş
/// hâli 64 KB ve aynı iki sayıyı veriyor.
[numthreads(SNOW_GROUP_SIZE, SNOW_GROUP_SIZE, 1)]
void KReduceState(uint3 id : SV_DispatchThreadID)
{
    uint outRes = 64;
    if (id.x >= outRes || id.y >= outRes) return;

    uint block = _Resolution / outRes;
    uint2 origin = id.xy * block;

    float swe = 0.0;
    float rhoN = 0.0;
    float visible = 0.0;
    float count = 0.0;

    for (uint y = 0; y < block; ++y)
    for (uint x = 0; x < block; ++x)
    {
        float4 s = _Snow[origin + uint2(x, y)];

        swe  += s.r;
        rhoN += s.g;
        visible += SnowBaseHeight(s.r, s.g) > SNOW_MIN_VISIBLE_HEIGHT ? 1.0 : 0.0;
        count += 1.0;
    }

    _ReducedOut[id.xy] = float4(swe / count, rhoN / count, visible / count, 1.0);
}

// ---------------------------------------------------------------- uzak kaskad

/// UZAK KASKAD (spec §21 Faz 10). 192 m, 512 teksel, iki kanal.
///
/// Yakın bölge 16 m; ondan ötesi eskiden SABİT bir değerdi ve dağın tamamı
/// aynı kalınlıkta kar taşıyordu. Kaskad orada da gerçek birikme ve erime
/// veriyor — teksel 37.5 cm, deformasyon yok.
Texture2D<float2>   _FarSrc;
RWTexture2D<float2> _FarDst;

uint   _FarResolution;
float  _FarAreaSize;
float2 _FarAreaCenter;
float2 _FarScrollTexels;
float2 _FarNewEdgeValue;

float2 FarTexelToWorld(uint2 id)
{
    float2 uv = (float2(id) + 0.5) / _FarResolution;
    return (uv - 0.5) * _FarAreaSize + _FarAreaCenter;
}

[numthreads(SNOW_GROUP_SIZE, SNOW_GROUP_SIZE, 1)]
void KFarScroll(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _FarResolution || id.y >= _FarResolution) return;

    int2 src = int2(id.xy) + int2(round(_FarScrollTexels));
    bool inside = all(src >= 0) && all(src < (int)_FarResolution);

    _FarDst[id.xy] = inside ? _FarSrc[src] : _FarNewEdgeValue;
}

/// Kaskadın birikmesi. §11'in SADELEŞTİRİLMİŞ hâli: yağış, oturma, erime,
/// yağmur. Rüzgâr yeniden dağıtımı ve gökyüzü örtüsü YOK — 37.5 cm tekselde
/// ikisinin de karşılığı yok, olsaydı gürültüden başka bir şey üretmezdi.
[numthreads(SNOW_GROUP_SIZE, SNOW_GROUP_SIZE, 1)]
void KFarAccumulate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _FarResolution || id.y >= _FarResolution) return;

    float2 s = _FarSrc[id.xy];

    float swe = s.x;
    float rho = SnowDensity(s.y);
    float dt  = _DeltaTimeEff;

    float fall = _SnowfallSWERate * dt;

    float rhoNew = clamp(55.0 + _WindSpeed * 7.5, 50.0, 320.0);

    float sweNext = swe + fall;
    rho = (rho * swe + rhoNew * fall) / max(sweNext, 1e-6);
    swe = sweNext;

    if (rho < 190.0) rho += (190.0 - rho) * (1.0 - exp(-dt / SNOW_SETTLE_TAU));

    float melt = SNOW_MELT_DDF * max(0.0, _TemperatureC);
    melt *= 1.0 + _RainOnSnow01 * SNOW_RAIN_MELT_BOOST;

    swe = clamp(swe - melt * dt, 0.0, SNOW_SWE_MAX);

    _FarDst[id.xy] = float2(swe, SnowDensityN(rho));
}

// ------------------------------------------------------------------ kalıcılık

/// KALICILIK [KAYNAK: Rockstar patenti US11534688B2]. Bölgeden çıkan blok
/// paketlenip saklanıyor, geri dönülünce yazılıyor.
///
/// ASSUMPTION: blok İNDİRGENMİŞ çözünürlükte saklanıyor. Spec 4×4 m blok
/// diyor; tam çözünürlükte bir blok 256×256 teksel yani 256 KB, LRU 512
/// blokla 128 MB eder. Dörde indirgenince (6.25 cm/teksel) 16 KB ve toplam
/// 8 MB — ayak izleri o çözünürlükte hâlâ okunuyor.
RWStructuredBuffer<float4> _BlockBuffer;

/// Bloğun bölge içindeki sol alt köşesi, teksel.
int2 _BlockOrigin;

/// Bir blok kenarının kaç teksel olduğu (tam çözünürlükte).
uint _BlockTexels;

/// Saklanan bloğun kenarı, teksel.
uint _BlockStored;

[numthreads(SNOW_GROUP_SIZE, SNOW_GROUP_SIZE, 1)]
void KBlockPack(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _BlockStored || id.y >= _BlockStored) return;

    uint step = _BlockTexels / _BlockStored;
    int2 origin = _BlockOrigin + int2(id.xy * step);

    float4 sum = 0.0;
    float count = 0.0;

    for (uint y = 0; y < step; ++y)
    for (uint x = 0; x < step; ++x)
    {
        int2 p = clamp(origin + int2(x, y), int2(0, 0),
                       int2((int)_Resolution - 1, (int)_Resolution - 1));

        float4 snow = _Snow[p];
        float4 trail = _Trail[p];

        sum += float4(snow.r, snow.g, trail.r, trail.g);
        count += 1.0;
    }

    _BlockBuffer[id.y * _BlockStored + id.x] = sum / count;
}

[numthreads(SNOW_GROUP_SIZE, SNOW_GROUP_SIZE, 1)]
void KBlockUnpack(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _BlockTexels || id.y >= _BlockTexels) return;

    int2 target = _BlockOrigin + int2(id.xy);

    if (any(target < 0) || any(target >= (int)_Resolution)) return;

    uint step = _BlockTexels / _BlockStored;
    uint2 src = id.xy / step;

    float4 stored = _BlockBuffer[src.y * _BlockStored + src.x];

    float4 snow = _Snow[target];
    float4 trail = _Trail[target];

    // YALNIZ SAKLANAN KANALLAR YAZILIYOR. Islaklık ve tazelik anlık durum;
    // geri yüklenirse kar "eskiden nasılsa öyle" görünür.
    snow.r = stored.x;
    snow.g = stored.y;
    trail.r = stored.z;
    trail.g = stored.w;

    _SnowOut[target] = snow;
    _TrailOut[target] = trail;
}
