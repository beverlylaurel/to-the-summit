// ROL: kar tanelerinin ve yer savrulmasının simülasyonu (§10.1).
//
// ASSUMPTION: spec bu işi VFX Graph'a veriyor ama VFX Graph paketi projede kurulu
// değil ve `.vfx` bir düğüm grafiği — metin olarak üretilemez. Fizik, sayılar ve
// davranış §10.1'den birebir; yalnız taşıyıcı değişti. Projede yağmur da aynı yolla
// çiziliyor, yani ikinci bir teknoloji girmiyor.
//
// Çağıran: SnowfallController.

#pragma kernel KFlakeInit
#pragma kernel KFlakeSimulate
#pragma kernel KLooseFraction

#include "SnowCommon.hlsl"
#include "SnowSparkle.hlsl"   // SnowHash33

struct SnowFlake
{
    float3 position;
    float  age;
    float3 velocity;
    float  lifetime;
    float  seed;
    float  size;
    float  alpha;
    float  spin;
};

RWStructuredBuffer<SnowFlake> _Flakes;

uint  _FlakeCapacity;
uint  _FlakeActive;       // bundan büyük indeksli taneler çizilmiyor
uint  _FlakeSpindrift;    // 1 = yer savrulması sistemi

float3 _FlakeBoxCenter;   // 1 m ızgarasına snap'lenmiş
float3 _FlakeBoxSize;

float  _FlakeDeltaTime;
float  _FlakeTime;

float3 _FlakeWind;
float  _FlakeWindSpeed;
float  _FlakeWetness;

float  _FlutterFreq;
float  _FlutterAmp;

// Rastgele sayı ÜRETİLMİYOR, hash'leniyor: her tanenin kendi tohumu var ve
// yeniden doğduğunda tohum ilerliyor. Böylece kare hızından bağımsız.
/// Uzayda ve zamanda aradeğerlenmiş değer gürültüsü, [0,1].
///
/// Sekiz köşe iki zaman diliminde örnekleniyor; kübik yumuşatmayla geçiş
/// türevi de sürekli oluyor. Adım fonksiyonu tanenin hızını birden çeviriyordu.
float3 SnowSmoothNoise3(float3 p, float t)
{
    float3 i = floor(p);
    float3 f = p - i;
    f = f * f * (3.0 - 2.0 * f);

    float ti = floor(t);
    float tf = t - ti;
    tf = tf * tf * (3.0 - 2.0 * tf);

    float3 result = 0;

    [unroll] for (int slice = 0; slice < 2; ++slice)
    {
        float3 c000 = SnowHash33(i + float3(0, 0, 0) + (ti + slice) * 37.0);
        float3 c100 = SnowHash33(i + float3(1, 0, 0) + (ti + slice) * 37.0);
        float3 c010 = SnowHash33(i + float3(0, 1, 0) + (ti + slice) * 37.0);
        float3 c110 = SnowHash33(i + float3(1, 1, 0) + (ti + slice) * 37.0);
        float3 c001 = SnowHash33(i + float3(0, 0, 1) + (ti + slice) * 37.0);
        float3 c101 = SnowHash33(i + float3(1, 0, 1) + (ti + slice) * 37.0);
        float3 c011 = SnowHash33(i + float3(0, 1, 1) + (ti + slice) * 37.0);
        float3 c111 = SnowHash33(i + float3(1, 1, 1) + (ti + slice) * 37.0);

        float3 x00 = lerp(c000, c100, f.x);
        float3 x10 = lerp(c010, c110, f.x);
        float3 x01 = lerp(c001, c101, f.x);
        float3 x11 = lerp(c011, c111, f.x);

        float3 y0 = lerp(x00, x10, f.y);
        float3 y1 = lerp(x01, x11, f.y);

        result += lerp(y0, y1, f.z) * (slice == 0 ? (1.0 - tf) : tf);
    }

    return result;
}

float3 FlakeRandom(float seed, float salt)
{
    return SnowHash33(float3(seed * 977.13, salt * 131.7, seed * 0.37 + salt));
}

/// Taneyi doğum kutusunun içinde yeniden konumlandırır.
///
/// KUTUNUN TAMAMINA doğuluyor, yalnız üstüne değil: hacim anında dolu olsun.
/// Kenarlarda pop görünmesin diye ömrün ilk ve son %8'inde alfa geçişi var.
void RespawnFlake(inout SnowFlake f, uint id)
{
    f.seed += 1.618;

    float3 r0 = FlakeRandom(f.seed, id + 1);
    float3 r1 = FlakeRandom(f.seed, id + 101);

    if (_FlakeSpindrift == 0)
    {
        f.position = _FlakeBoxCenter + (r0 - 0.5) * _FlakeBoxSize;
        f.lifetime = lerp(4.0, 9.0, r1.x);

        // Düşme hızı: kuru kar yavaş ve takla atarak, ıslak kar hızlı ve dik.
        float dry = lerp(0.6, 1.4, r1.y);
        float wet = lerp(1.4, 3.0, r1.z);
        float terminal = lerp(dry, wet, _FlakeWetness);

        f.velocity = _FlakeWind + float3(0.0, -terminal, 0.0);

        f.size = 0.018 * lerp(0.6, 1.7, r0.z);
        f.alpha = 1.0;
    }
    else
    {
        // YER SAVRULMASI: kameranın rüzgâr yönündeki şeridinde, zemin kotunda doğuyor.
        float3 windDir = _FlakeWindSpeed > 1e-3 ? _FlakeWind / _FlakeWindSpeed : float3(0, 0, 1);
        float3 side = normalize(cross(float3(0, 1, 0), windDir));

        float2 strip = (r0.xy - 0.5) * float2(30.0, 30.0);
        float3 origin = _FlakeBoxCenter + windDir * strip.x + side * strip.y;

        origin.y = SampleGroundHeight(origin.xz) + r0.z * 0.15;

        f.position = origin;
        f.lifetime = lerp(1.2, 3.0, r1.x);
        f.velocity = _FlakeWind * lerp(0.7, 1.1, r1.y) + float3(0.0, lerp(0.2, 0.8, r1.z), 0.0);
        f.size = 0.014 * lerp(0.8, 1.6, r0.z);
        f.alpha = 0.12;
    }

    f.age = 0.0;
    f.spin = (FlakeRandom(f.seed, id + 7).x - 0.5) * 3.1416;
}

[numthreads(64, 1, 1)]
void KFlakeInit(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _FlakeCapacity) return;

    SnowFlake f = (SnowFlake)0;
    f.seed = id.x * 0.0137 + 3.7;

    RespawnFlake(f, id.x);

    // Yaşlar dağıtılıyor: hepsi aynı anda ölüp aynı anda doğarsa nabız gibi atıyor.
    f.age = FlakeRandom(f.seed, id.x + 55).x * f.lifetime;

    _Flakes[id.x] = f;
}

[numthreads(64, 1, 1)]
void KFlakeSimulate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _FlakeCapacity) return;

    SnowFlake f = _Flakes[id.x];

    if (id.x >= _FlakeActive)
    {
        // Etkin olmayan taneler görünmüyor ama tohumları korunuyor: yağış artınca
        // dağılmış hâlde geri geliyorlar.
        f.alpha = 0.0;
        _Flakes[id.x] = f;
        return;
    }

    float dt = _FlakeDeltaTime;
    f.age += dt;

    if (f.age >= f.lifetime)
    {
        RespawnFlake(f, id.x);
        _Flakes[id.x] = f;
        return;
    }

    // TÜRBÜLANS SÜREKLİ OLMAK ZORUNDA.
    //
    // Önce hücre hash'i kullanılıyordu: gürültü her 8 metrede ve her 1.1 saniyede
    // BİRDEN değişiyor, tane anında yön değiştiriyor ve yolu zikzak çiziyordu.
    // Ölçüldü — kullanıcı "karlar zikzak çiziyor" dedi.
    //
    // Şimdi hem uzayda hem zamanda aradеğerlenmiş: yön yumuşak dönüyor.
    float3 noise = SnowSmoothNoise3(f.position * 0.12, _FlakeTime * 0.35) * 2.0 - 1.0;
    float turbulence = 0.35 * _FlakeWindSpeed + 0.15;

    float3 target = _FlakeWind + float3(0.0, f.velocity.y, 0.0) + noise * turbulence;
    // SÜRTÜNME ÜSTEL. `dt * 0.9` kare hızına bağlıydı ve 60 fps'te kat sayısı 0.015
    // çıkıyordu: tane rüzgâra saniyeler boyunca yetişemiyor, yağış dik iniyordu.
    // Kullanıcı "kar rüzgârdan etkilenmiyor" dedi.
    //
    // 1 - exp(-dt/tau) kare hızından bağımsız. tau = 0.35 s: kar tanesinin gerçek
    // eylemsizlik zamanı (v_t/g = 1.0/9.81 = 0.1 s ile aynı mertebe, taklaları
    // hesaba katan biraz büyük değer).
    f.velocity = lerp(f.velocity, target, 1.0 - exp(-dt / 0.35));

    f.position += f.velocity * dt;

    // SALINIM. Kuru kar taneleri takla atar, ıslak olanlar düşer.
    if (_FlakeSpindrift == 0)
    {
        float phase = f.seed * 6.2831;
        float2 flutter = float2(sin(f.age * _FlutterFreq + phase),
                                cos(f.age * _FlutterFreq * 0.83 + phase));

        f.position.xz += flutter * (_FlutterAmp * (1.0 - _FlakeWetness) * dt);
    }

    // Ömür uçlarında alfa geçişi.
    float t = f.age / max(f.lifetime, 1e-3);
    float fade = saturate(t / 0.08) * saturate((1.0 - t) / 0.08);

    float baseAlpha = _FlakeSpindrift == 0 ? 1.0 : 0.12;

    if (_FlakeSpindrift != 0)
    {
        // Yükseldikçe sönüyor: savrulma yerden kopunca dağılıyor.
        float ground = SampleGroundHeight(f.position.xz);
        baseAlpha *= 1.0 - saturate((f.position.y - ground) / 1.8);
    }

    // ÖRTÜ KESME. Çatı altına, köprü altına, ağaç altına kar yağmaz. Bu blok
    // sistemin en çok fark edilen gerçekçilik detaylarından biri (§10.1).
    float2 occlUV = (f.position.xz - _OcclCenterXZ) / _OcclAreaSize + 0.5;

    if (!(any(occlUV < 0.0) || any(occlUV > 1.0)))
    {
        float occlY = SAMPLE_TEXTURE2D_LOD(_SnowOcclusionTex, snow_linear_clamp_sampler, occlUV, 0).r;
        float above = occlY - f.position.y;

        baseAlpha *= 1.0 - smoothstep(0.0, 0.5, above);

        if (above > 1.5)
        {
            RespawnFlake(f, id.x);
            _Flakes[id.x] = f;
            return;
        }
    }

    // ZEMİN KESME.
    if (f.position.y < SampleGroundHeight(f.position.xz) + 0.02)
    {
        RespawnFlake(f, id.x);
        _Flakes[id.x] = f;
        return;
    }

    f.alpha = baseAlpha * fade;

    _Flakes[id.x] = f;
}

// --- gevşek kar oranı ---

/// Durum dokusu burada YALNIZ OKUNUYOR; yazan SnowSim.compute.
Texture2D<float4> _State;
uint _Resolution;

RWStructuredBuffer<uint> _LooseOut;
groupshared float gLoose[64];

/// Yüzeydeki gevşek kar oranı: ortalama (1 - rhoN). Yer savrulması bununla
/// kapıda tutuluyor — sıkışmış patikadan kar savrulmaz.
[numthreads(8, 8, 1)]
void KLooseFraction(uint3 id : SV_DispatchThreadID, uint gi : SV_GroupIndex)
{
    float value = (id.x < _Resolution && id.y < _Resolution)
                ? saturate(1.0 - _State[id.xy].g)
                : 0.0;

    gLoose[gi] = value;
    GroupMemoryBarrierWithGroupSync();

    [unroll] for (uint stride = 32; stride > 0; stride >>= 1)
    {
        if (gi < stride) gLoose[gi] += gLoose[gi + stride];
        GroupMemoryBarrierWithGroupSync();
    }

    if (gi == 0) InterlockedAdd(_LooseOut[0], (uint)(gLoose[0] * 64.0));
}

