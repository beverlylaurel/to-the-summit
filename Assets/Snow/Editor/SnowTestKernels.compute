// ROL: yalniz sinama icin. Her teksele KENDI GPU id'sini yaziyor; kaydirma
// sinamasi boylece okuma yolundaki olasi y-cevrimini olcup hesaba katabiliyor.
// Caginan: SnowScrollTest. Editor klasorunde -> derlemeye girmiyor.

#pragma kernel KStamp
#pragma kernel KGlobalProbe

RWTexture2D<float4> _Dst;
uint _Resolution;

/// GLOBAL SORGUSU. `Shader.SetGlobalFloat` ile yazilan bir deger compute
/// shader'a ULASIYOR MU? Cevabi hatirlamak yerine olcmek icin.
float _ProbeGlobalA;
float _ProbeGlobalB;

/// Global DOKU compute'a ulasiyor mu. Float'larin ulastigi olculdu; doku ayri
/// bir soru ve projede `_GroundHeightTex` kernel BASINA baglaniyor.
Texture2D<float4> _ProbeGlobalTex;
SamplerState sampler_ProbeGlobalTex;

[numthreads(1, 1, 1)]
void KGlobalProbe(uint3 id : SV_DispatchThreadID)
{
    float tex = _ProbeGlobalTex.SampleLevel(sampler_ProbeGlobalTex, float2(0.5, 0.5), 0).r;
    _Dst[uint2(0, 0)] = float4(_ProbeGlobalA, _ProbeGlobalB, tex, 1.0);
}

[numthreads(8, 8, 1)]
void KStamp(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution) return;
    _Dst[id.xy] = float4(id.x, id.y, 0.0, 1.0);
}

// --------------------------------------------------------------- Faz 6 sinamalari

#pragma kernel KTestSparkle
#pragma kernel KTestRnm

// SnowSparkle bunlari SnowLitInput'un CBUFFER'indan aliyor; burada tek tek
// tanimlaniyor ki kernel URP isiklandirmasini yuklemek zorunda kalmasin.
float _SparkleCellSize;
float _SparkleDensity;
float _SparkleSharpness;

// SnowDetailNormals TEXTURE2D/UnpackNormal makrolarini kullaniyor; onlar
// core kutuphanesinden geliyor.
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Packing.hlsl"

#include "../Shaders/SnowSparkle.hlsl"
#include "../Shaders/SnowDetailNormals.hlsl"

RWTexture2D<float4> _TestOut;

float  _TestFootprint;
float3 _TestViewDir;
float3 _TestLightDir;

/// Verilen piksel ayak izinde, dunya uzerinde yayilmis noktalarda paritinin
/// degeri. CPU tarafi bunun esigi asma oranini sayiyor: Bowles & Wang'in
/// iddiasi tam olarak bu oranin mesafeden BAGIMSIZ olmasi.
[numthreads(8, 8, 1)]
void KTestSparkle(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution) return;

    // Ornekleme araligi ayak iziyle olcekleniyor: gercek bir ekranda da
    // komsu pikseller bir ayak izi kadar ayriktir.
    float2 posXZ = (float2(id.xy) + 0.5) * _TestFootprint;

    float3 posWS = float3(posXZ.x, 0.0, posXZ.y);

    _TestOut[id.xy] = SnowSparkle(posWS, normalize(_TestViewDir),
                                  normalize(_TestLightDir), _TestFootprint);
}

/// RNM'nin uc ozelligi: duz detayla taban degismez, duz tabanla detay aynen
/// gecer, sonuc birim uzunluktadir.
[numthreads(8, 8, 1)]
void KTestRnm(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= 3 || id.y >= 1) return;

    float3 flat_ = float3(0.5, 0.5, 1.0);

    // Egik bir ornek normal, paketli hale getirilmis.
    float3 tilted = normalize(float3(0.4, -0.3, 0.86));
    float3 tiltedPacked = tilted * 0.5 + 0.5;

    float3 result;

    if (id.x == 0)      result = RNMBlend(tiltedPacked, flat_) - tilted;
    else if (id.x == 1) result = RNMBlend(flat_, tiltedPacked) - tilted;
    else                result = float3(length(RNMBlend(tiltedPacked, tiltedPacked)), 0, 0);

    _TestOut[id.xy] = float4(result, 1.0);
}

// --------------------------------------------------------------- Faz 7 sinamasi

#pragma kernel KTestCoverMask

float _SnowSlopeThreshold;
float _SnowSlopeSharpness;
float _SnowBreakupScale;
float _SnowBreakupStrength;
float _SnowEdgeSharpness;

#include "../Shaders/SnowCover.hlsl"

float3 _TestNormal;
float  _TestAo;
float3 _TestPosition;

/// Tek deger: verilen normal, AO ve konum icin kaplama maskesi.
/// CPU tarafi bunu farkli normallerle cagirip esik davranisini olcuyor.
[numthreads(1, 1, 1)]
void KTestCoverMask(uint3 id : SV_DispatchThreadID)
{
    _TestOut[uint2(0, 0)] = SnowCoverMaskWithNoise(_TestPosition, normalize(_TestNormal),
                                                   _TestAo, 0.5,
                                                   _SnowSlopeThreshold, _SnowSlopeSharpness,
                                                   _SnowBreakupStrength, _SnowEdgeSharpness);
}

// --------------------------------------------------------------- Faz 12 sinamasi

#pragma kernel KTestSastrugi
#pragma kernel KTestHeat

float2 _TestAxis;
float  _TestStep;
float  _TestAmplitude;

/// Sastrugi yuksekligi verilen eksen boyunca. CPU tarafi bunu ruzgar yonunde
/// ve ruzgara dik yonde ayri ayri cagirip degisim hizini karsilastiriyor:
/// sirtlar ruzgara DIK uzanmali (spec 18.4).
[numthreads(64, 1, 1)]
void KTestSastrugi(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution) return;

    float2 posXZ = _TestAxis * (id.x * _TestStep);

    _TestOut[uint2(id.x, 0)] = SnowSastrugiOffset(posXZ, _TestAmplitude);
}

/// Isi alani verilen eksen boyunca. Wyvill dususu yaricapinda TAM sifir
/// olmali; lineer ya da Gauss kullanilsaydi kuyruk kalirdi.
[numthreads(64, 1, 1)]
void KTestHeat(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution) return;

    float3 posWS = float3(_TestAxis.x, 0.0, _TestAxis.y) * (id.x * _TestStep);

    _TestOut[uint2(id.x, 0)] = SnowHeatField(posWS);
}
