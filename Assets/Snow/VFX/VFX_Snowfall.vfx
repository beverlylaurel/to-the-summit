  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966678459}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966678548}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966678547}
  m_BlockName: "\xD6m\xFCr solmas\u0131 ve zemin kesme"
  m_HLSLCode: "void SnowFlakeFadeAndKill(inout VFXAttributes attributes, in float
    groundY)\n{\n    float t = attributes.age / max(attributes.lifetime, 1e-4);\n\n   
    float fadeIn  = smoothstep(0.0, 0.08, t);\n    float fadeOut = 1.0 - smoothstep(0.92,
    1.0, t);\n\n    attributes.alpha = fadeIn * fadeOut;\n\n    // POZ\u0130SYON
    YEREL UZAYDA, KOT DA YEREL GEL\u0130YOR.\n    //\n    // \xDC\xE7 s\xFCr\xFCm
    denendi, ikisi kar\u0131n TAMAMINI sildi (`alive = 0`):\n    //   1. `position.y`
    ile D\xDCNYA kotu kar\u015F\u0131la\u015Ft\u0131r\u0131ld\u0131 \u2014 yerel
    y \xB110 iken\n    //      kot 205, ko\u015Ful her tane i\xE7in do\u011Fru.\n   
    //   2. `TransformPositionVFXToWorld(position)` eklendi \u2014 sonu\xE7 yine\n   
    //      s\u0131f\u0131r\u0131n alt\u0131nda \xE7\u0131kt\u0131; fonksiyon burada
    beklendi\u011Fi gibi\n    //      davranm\u0131yor (\xF6l\xE7\xFCld\xFC: `groundY
    = 0` iken bile hepsi \xF6ld\xFC).\n    //   3. D\xF6n\xFC\u015F\xFCm kald\u0131r\u0131ld\u0131,
    kot C# taraf\u0131nda yerele \xE7evrildi. `SnowfallLayers`\n    //      `zeminKotu
    - kutuKonumu` g\xF6nderiyor; ikisi de orada d\xFCnya\n    //      koordinat\u0131
    olarak biliniyor, tahmin gerekmiyor.\n    if (attributes.position.y < groundY
    + 0.02)\n        attributes.alive = false;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SnowFlakeFadeAndKill
    selectedIndex: 0
