  m_ActivationSlot: {fileID: 114350483966679765}
  m_BlockName: "Sal\u0131n\u0131m"
  m_HLSLCode: "void SnowFlakeFlutter(inout VFXAttributes attributes)\r\n{\r\n   
    float faz = frac(sin(float(attributes.particleId) * 12.9898) * 43758.5453) *
    6.2831853;\r\n\r\n    attributes.position += float3(-cos(attributes.age * 5.5
    + faz) * (0.35 / 5.5),\r\n                                   0.0,\r\n                                  
    sin(attributes.age * 4.6 + faz) * (0.35 / 4.6));\r\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SnowFlakeFlutter
    selectedIndex: 0
