  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966679329}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966679418}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966679417}
  m_BlockName: "\xD6m\xFCr solmas\u0131 ve zemin kesme"
  m_HLSLCode: "void SnowFlakeFadeAndKill(inout VFXAttributes attributes, in float
    groundY)\r\n{\r\n    float t = attributes.age / max(attributes.lifetime, 1e-4);\r\n\r\n   
    float fadeIn  = smoothstep(0.0, 0.08, t);\r\n    float fadeOut = 1.0 - smoothstep(0.92,
    1.0, t);\r\n\r\n    attributes.alpha = fadeIn * fadeOut;\r\n\r\n    // POZ\u0130SYON
    D\xDCNYA UZAYINDA, KOT DA D\xDCNYA GEL\u0130YOR.\r\n    //\r\n    // Sistem `SetWorldSpace`
    ile d\xFCnya uzay\u0131na al\u0131nd\u0131 (gerek\xE7e orada); art\u0131k\r\n   
    // `attributes.position` do\u011Frudan d\xFCnya koordinat\u0131 ve `SnowfallLayers`\r\n   
    // zemin kotunu oldu\u011Fu gibi yolluyor.\r\n    //\r\n    // Sistem YEREL iken
    bu sat\u0131r iki kez kar\u0131n TAMAMINI silmi\u015Fti: bir kez\r\n    // d\xFCnya
    kotu yerel y ile kar\u015F\u0131la\u015Ft\u0131r\u0131ld\u0131\u011F\u0131 i\xE7in,
    bir kez de\r\n    // `TransformPositionVFXToWorld` beklendi\u011Fi gibi davranmad\u0131\u011F\u0131
    i\xE7in\r\n    // (\xF6l\xE7\xFCld\xFC: `groundY = 0` iken bile hepsi \xF6ld\xFC).
    Uzay d\xFCzelince ikisi de\r\n    // konu d\u0131\u015F\u0131 kald\u0131.\r\n   
    if (attributes.position.y < groundY + 0.02)\r\n        attributes.alive = false;\r\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SnowFlakeFadeAndKill
    selectedIndex: 0
