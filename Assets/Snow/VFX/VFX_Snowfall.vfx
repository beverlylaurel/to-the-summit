--- !u!114 &114350483966679056
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966679028}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots: []
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966679062}
  m_BlockName: Asgari ekran boyutu
  m_HLSLCode: "void SnowMinScreenSize(inout VFXAttributes attributes)\r\n{\r\n   
    const float minPixelSize = 1.3f;\r\n\r\n    float clipPosW = TransformPositionVFXToClip(attributes.position).w;\r\n\r\n   
    float denom = attributes.size * 0.5f\r\n                * min(abs(UNITY_MATRIX_P[0][0]
    * _ScreenParams.x),\r\n                      abs(UNITY_MATRIX_P[1][1] * _ScreenParams.y));\r\n\r\n   
    float2 newScale = (float2(minPixelSize, minPixelSize) * clipPosW) / max(denom,
    1e-6f);\r\n\r\n    float2 eski   = float2(attributes.scaleX, attributes.scaleY);\r\n   
    float2 buyumus = max(eski, newScale);\r\n\r\n    // ENERJI KORUNUMU. Taneyi piksel
    tabanina cekmek kapladigi ALANI buyutur;\r\n    // alfa ayni kalirsa buyume orani
    kadar isik UYDURULUR. 40 m'deki tane\r\n    // gercek alaninin 14 katini tam
    alfayla boyuyordu ve 89 bin tane ust uste\r\n    // binince ekranda sut gibi
    bir ortu cikiyordu (olculdu).\r\n    float alanOrani = (buyumus.x * buyumus.y)
    / max(eski.x * eski.y, 1e-6f);\r\n    attributes.alpha *= saturate(1.0f / max(alanOrani,
    1.0f));\r\n\r\n    attributes.scaleX = buyumus.x;\r\n    attributes.scaleY =
    buyumus.y;\r\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SnowMinScreenSize
    selectedIndex: 0
