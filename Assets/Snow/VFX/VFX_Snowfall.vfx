  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966678680}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots: []
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966678714}
  m_BlockName: Asgari ekran boyutu
  m_HLSLCode: "void SnowMinScreenSize(inout VFXAttributes attributes)\n{\n    const
    float minPixelSize = 1.3f;\n\n    float clipPosW = TransformPositionVFXToClip(attributes.position).w;\n\n   
    float denom = attributes.size * 0.5f\n                * min(abs(UNITY_MATRIX_P[0][0]
    * _ScreenParams.x),\n                      abs(UNITY_MATRIX_P[1][1] * _ScreenParams.y));\n\n   
    float2 newScale = (float2(minPixelSize, minPixelSize) * clipPosW) / denom;\n\n   
    attributes.scaleX = max(attributes.scaleX, newScale.x);\n    attributes.scaleY
    = max(attributes.scaleY, newScale.y);\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SnowMinScreenSize
    selectedIndex: 0
