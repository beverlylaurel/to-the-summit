# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated crash report
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Package manager
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/[Jj]etBrains*

# OS
.DS_Store
Thumbs.db

# Unity otomatik yedekleri
/[Bb]ackups/

# Git LFS'in kancaları Windows'ta /dev/null yerine buraya yazıyor. İşlevsiz kopyalar;
# gerçek kancalar .git/hooks'ta. Her LFS işleminde yeniden beliriyorlar.
/dev/

# TÜRETİLEN ARAZİ VARLIKLARI. Kurulum betiği açılışta kendisi pişiriyor. Depoda
# tutmanın tek sonucu her üretimde LFS'e yetmiş megabayt daha yazmaktı — 3.8 GB
# oraya gitti.
#
# GEREKÇE L1'DE DEĞİŞTİ. Eskiden buradaki cümle "hepsi tohum ve ayarlardan birebir
# yeniden üretiliyor" idi ve DOĞRUYDU: `MountainGenerator` radyal koniyi
# `MountainSettings`'ten hesaplıyordu. Artık arazi Argudo boru hattından geliyor ve
# onu üretmek için Python, `orometry-terrains` ve 1.4 GB'lık Kirmse veritabanı
# gerekiyor — hiçbiri repoda değil, olamaz da.
#
# Bu yüzden `Assets/Terrain/MountainHeightmap.png` (13.7 MB) BURADA DEĞİL: o artık
# türetilmiş değil KAYNAK. Aşağıdakiler ondan tek adımda pişiyor ve dışlanmaya
# devam ediyor (toplam ~165 MB).
#
# Elle alınan doku setleri (SnowPowder, SnowPacked) BURADA DEĞİL: onlar üretilemiyor.
Assets/Terrain/MountainTerrainData.asset*
Assets/Terrain/MountainHeight.asset*
Assets/Terrain/MountainHorizon.asset*
Assets/Terrain/MountainNormals.asset*
Assets/Terrain/MountainSurfaceMaps.asset*
Assets/Terrain/MountainSnowDrift.asset*
Assets/Terrain/RouteShapeMask.png*

# ÜRETİLEN BİSİKLET MESH'LERİ. Jant düzeltmesi ve bölge ayrımı kaynaktan yeniden
# hesaplanıyor; depoya yazmanın bedeli var, kazancı yok.
#
# BOYANMIŞ MESH'LER HARİÇ. Onlar elle boyandı, yeniden üretilemez: silinirse iş
# baştan yapılır. Klasörün kendisi değil İÇERİĞİ yok sayılıyor, yoksa istisna
# çalışmıyor — git, dışlanmış bir klasörün içindeki dosyayı geri alamıyor.
Assets/Models/Bike/Generated/*
!Assets/Models/Bike/Generated/*_Paint.asset
!Assets/Models/Bike/Generated/*_Paint.asset.meta

# Arka plan yenileme tetikleyicisi. Icerigi onemsiz, yalniz zaman damgasi okunuyor.
Logs/refresh.trigger

# Arazi uretiminin ARA ciktilari. Repoya giren sey Assets/Terrain/DivideTree.txt;
# npz ve dogrulama gorselleri ondan yeniden uretilebilir.
Tools/terrain/*.npz
Tools/terrain/*.npy
Tools/terrain/*.png
Tools/terrain/data/

# Divide Tree ASSET'i turetilmis: kaynagi Assets/Terrain/DivideTree.txt ve
# ice aktarma araci onu tek adimda uretiyor.
Assets/Terrain/DivideTree.asset*
Tools/terrain/__pycache__/

# Yontma araci yedekleri: rotasyon autosave + kurtarma kopyalari transient.
# Repoya giren deliverable yalniz guncel dag (_son.bytes) ve adli kayitlar.
Assets/Terrain/Sculpts/*.yedek*.bytes*
Assets/Terrain/Sculpts/_kurtarma.bytes*
